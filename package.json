{
  "name": "dsh-mnemosyne",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "分层长期记忆：每轮只注入「人设框架 + 相关记忆索引」，原文留磁盘按需展开；人设由模型从记忆里自行归纳，记忆会自动合并与固化，存储也会压缩。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "memory",
    "long-term-memory",
    "context",
    "persona"
  ],
  "homepage": "https://github.com/i11ustriouS/dsh-mnemosyne#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/i11ustriouS/dsh-mnemosyne.git"
  },
  "bugs": {
    "url": "https://github.com/i11ustriouS/dsh-mnemosyne/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "license": "MIT"
}
